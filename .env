# ===================================================
# CYBER FLOCK DEFENSE HUB - Environment Configuration
# ===================================================

# Application
APP_NAME="CYBER FLOCK DEFENSE HUB"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: SQLite for zero-setup local dev. Set postgresql://... for PostgreSQL)
DATABASE_URL=sqlite:///./cyber_flock.db
# DATABASE_URL=postgresql://cyberflock:cyberflock_secure_password@localhost:5432/cyberflock_db

# Security & JWT
JWT_SECRET_KEY=cyberflock_super_secret_jwt_encryption_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Administrator Credentials (for development seed)
ADMIN_EMAIL=admin@cyberflock.defense
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME="Super Administrator"

# Blockchain (Local Hardhat EVM Node)
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Google OAuth/OIDC (Service Abstraction)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Market Intelligence
ENABLE_MARKET_INTELLIGENCE=true
MARKET_DATA_PROVIDER=demo

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
